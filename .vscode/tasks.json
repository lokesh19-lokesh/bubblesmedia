{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Server",
      "type": "shell",
      "command": "npx http-server -a 127.0.0.1 -p 8080 -c-1",
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting up",
          "endsPattern": "Hit CTRL-C to stop the server"
        }
      }
    }
  ]
}